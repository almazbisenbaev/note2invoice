# Server-only credentials. Never put these in public/ or commit your .env.
# Save this file as .env. The running app picks up changes automatically.

# PayPal Developer Dashboard > Apps & Credentials > Sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Email of the BUSINESS sandbox account associated with the app.
# Find it under Testing Tools > Sandbox Accounts. Not your personal PayPal email.
PAYPAL_MERCHANT_EMAIL=

# Meta Model API (dev.meta.ai). Also supports openai, gemini, or anthropic.
AI_PROVIDER=meta
AI_API_KEY=
# Leave empty to use the provider default.
AI_MODEL=
# Optional: OpenAI-compatible API base URL (including /v1), otherwise leave empty.
AI_BASE_URL=

# Local development only. PayPal is permanently locked to sandbox in code.
PORT=3000
